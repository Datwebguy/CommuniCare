# Google Gemini API Key (Gemini 2.5 Flash / 3.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project Configuration (for Cloud Run and Firestore)
GOOGLE_CLOUD_PROJECT=communicare-agent-hackathon
FIRESTORE_DATABASE=(default)

# Server Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=True

# AAC Symbol Cache Directory
SYMBOL_CACHE_DIR=./data/symbols_cache
