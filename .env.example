# Google Gemini API Key (Gemini 3.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Firebase / GCP project (Firestore is the required Cloud service)
GOOGLE_CLOUD_PROJECT=your_firebase_or_gcp_project_id
FIRESTORE_DATABASE=(default)

# Paste the full service account JSON as ONE line (Firebase Spark works without Cloud Billing).
# Never commit the real JSON. Use GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json locally if you prefer.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# On Vercel, prefer base64 (no newlines). PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.json"))
# GOOGLE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...

# Server Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=True

# AAC Symbol Cache Directory
SYMBOL_CACHE_DIR=./data/symbols_cache
